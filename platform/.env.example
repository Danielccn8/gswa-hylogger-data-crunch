# Copy to platform/.env (ignored by Git) and adjust. Read by docker compose.
# Data root outside OneDrive; holds downloads, products and the GSWA reference package.
HYLOGGER_DATA_HOST=C:/HyLoggerData
# Optional earlier data root (read-only) whose raw ZIPs are reused without copying.
HYLOGGER_LEGACY_HOST=C:/Users/you/OneDrive - UWA/.../Data Crunch/data
# Ports bound on 127.0.0.1 only. They differ from the earlier stack (8000/5433).
HYLOGGER_API_PORT=8100
HYLOGGER_DB_PORT=5434
